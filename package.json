{
  "name": "cerulean-longing",
  "version": "0.1.43",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:package": "node scripts/desktop.mjs package",
    "contracts": "cargo run -p cerulean-domain --bin export-contracts",
    "test:ipc": "node --test tests/core-ipc.test.mjs",
    "test:service": "node --test tests/resident-service.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
